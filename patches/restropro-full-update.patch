+              <div>STRN {settings.fbr_strn || "—"}</div>
+            </div>
+          </div>
+        )}
+        {settings.receipt_footer && <div className="text-center mt-4 text-[10px] opacity-60">{settings.receipt_footer}</div>}
+      </div>
+    </div>
+  );
+}

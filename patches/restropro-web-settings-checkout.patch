diff --git a/lib/sales/extras.ts b/lib/sales/extras.ts
new file mode 100644
index 0000000..0863dfc
--- /dev/null
+++ b/lib/sales/extras.ts
@@ -0,0 +1,73 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+/** Bill extras the POS adds on top of what create_sale() knows about (items + tax + delivery):
+ *  the dine-in service charge and the FBR invoicing fee. create_sale() is a database function we
+ *  don't change, so they are applied right after it succeeds: the sale's total, its paid/unpaid
+ *  status and (when migration 0016 is applied) the two breakdown columns are updated together. */
+export type SaleExtras = { serviceCharge?: unknown; fbrFee?: unknown };
+export type SaleBase = { orderNo: number | string | null; total: number; status: string; balance: number };
+
+const money = (v: unknown) => {
+  const n = Number(v);
+  return Number.isFinite(n) && n > 0 && n < 10_000_000 ? Math.round(n * 100) / 100 : 0;
+};
+
+export async function applySaleExtras(
+  admin: SupabaseClient,
+  restaurantId: string,
+  base: SaleBase,
+  extras: SaleExtras,
+  paid: number
+): Promise<SaleBase & { saleId: string | null }> {
+  const serviceCharge = money(extras.serviceCharge);
+  const fbrFee = money(extras.fbrFee);
+  const extra = serviceCharge + fbrFee;
+
+  let saleId: string | null = null;
+  if (base.orderNo != null && base.orderNo !== "") {
+    const { data: row } = await admin
+      .from("sales")
+      .select("id")
+      .eq("restaurant_id", restaurantId)
+      .eq("order_no", base.orderNo)
+      .order("created_at", { ascending: false })
+      .limit(1)
+      .maybeSingle();
+    saleId = row?.id ?? null;
+  }
+  if (extra <= 0 || !saleId) return { ...base, saleId };
+
+  const total = Math.round((Number(base.total) + extra) * 100) / 100;
+  const status = base.status === "cancelled" ? base.status : paid + 0.005 >= total ? base.status : "unpaid";
+  const patch = { total, status };
+
+  let { error } = await admin.from("sales").update({ ...patch, service_charge: serviceCharge, fbr_fee: fbrFee }).eq("id", saleId);
+  if (error) ({ error } = await admin.from("sales").update(patch).eq("id", saleId)); // migration 0016 not applied yet
+  if (error) {
+    console.error("sale extras not applied", error);
+    return { ...base, saleId };
+  }
+  return { orderNo: base.orderNo, total, status, balance: Math.max(0, Math.round((total - paid) * 100) / 100), saleId };
+}
+
+export type CustomerUpdate = { name?: unknown; phone?: unknown; address?: unknown; areaId?: unknown };
+
+/** The cashier edited an existing customer's details in the checkout popup: save them. Never
+ *  fails the sale — a rejected update (for example a phone number that belongs to another
+ *  customer) is logged and skipped. */
+export async function applyCustomerUpdate(admin: SupabaseClient, restaurantId: string, customerId: string | null | undefined, u: CustomerUpdate | undefined) {
+  if (!customerId || !u || typeof u !== "object") return;
+  const patch: Record<string, unknown> = {};
+  const text = (v: unknown, max: number) => (typeof v === "string" ? v.trim().slice(0, max) : undefined);
+  const name = text(u.name, 120);
+  const phone = text(u.phone, 40);
+  const address = text(u.address, 300);
+  if (name) patch.name = name;
+  if (phone) patch.phone = phone;
+  if (address !== undefined) patch.address = address;
+  if (u.areaId === null || typeof u.areaId === "string") patch.area_id = u.areaId || null;
+  if (Object.keys(patch).length === 0) return;
+
+  const { error } = await admin.from("customers").update(patch).eq("id", customerId).eq("restaurant_id", restaurantId);
+  if (error) console.error("customer update skipped", error.message);
+}
diff --git a/supabase/migrations/0016_ordering_and_sale_charges.sql b/supabase/migrations/0016_ordering_and_sale_charges.sql
new file mode 100644
index 0000000..4fb9adb
--- /dev/null
+++ b/supabase/migrations/0016_ordering_and_sale_charges.sql
@@ -0,0 +1,39 @@
+-- =====================================================================
+-- RESTRO PRO — Supabase migration 0016
+-- 1. sort_order on payment_methods, tables and delivery_areas, so the Settings page can let the
+--    owner rearrange them (POS, checkout and the desktop app follow the same order).
+--    It is an IDENTITY column: rows created later automatically get the next number, so a new
+--    table / area / method appears at the end of the list without any code. Existing rows are
+--    numbered once, in their previous order (name; tables: number). Safe to run twice.
+-- 2. sales.service_charge and sales.fbr_fee: the dine-in service charge and the FBR invoicing
+--    fee that are part of the bill total (the receipt shows them; they are stored here too).
+-- =====================================================================
+
+do $$
+begin
+  if not exists (select 1 from information_schema.columns where table_schema = 'public' and table_name = 'payment_methods' and column_name = 'sort_order') then
+    alter table public.payment_methods add column sort_order bigint generated by default as identity;
+    update public.payment_methods p set sort_order = r.rn
+      from (select id, row_number() over (partition by restaurant_id order by name) as rn from public.payment_methods) r
+      where r.id = p.id;
+  end if;
+
+  if not exists (select 1 from information_schema.columns where table_schema = 'public' and table_name = 'tables' and column_name = 'sort_order') then
+    alter table public.tables add column sort_order bigint generated by default as identity;
+    update public.tables t set sort_order = r.rn
+      from (select id, row_number() over (partition by restaurant_id order by length(number::text), number::text) as rn from public.tables) r
+      where r.id = t.id;
+  end if;
+
+  if not exists (select 1 from information_schema.columns where table_schema = 'public' and table_name = 'delivery_areas' and column_name = 'sort_order') then
+    alter table public.delivery_areas add column sort_order bigint generated by default as identity;
+    update public.delivery_areas d set sort_order = r.rn
+      from (select id, row_number() over (partition by restaurant_id order by name) as rn from public.delivery_areas) r
+      where r.id = d.id;
+  end if;
+end $$;
+
+alter table public.sales add column if not exists service_charge numeric not null default 0;
+alter table public.sales add column if not exists fbr_fee numeric not null default 0;
+
+notify pgrst, 'reload schema';
